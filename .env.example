# ---------- APP CONFIGURATION ----------
APP_NAME="Jira Slack Bot"
APP_ENV=development # Options: development, production

# ---------- JIRA CONFIGURATION ----------
JIRA_URL="https://your-domain.atlassian.net"
JIRA_EMAIL="your-email@example.com"
JIRA_TOKEN="your-jira-api-token"
PROJECT_KEY="KAN"

# ---------- SLACK CONFIGURATION ----------
# You can use a Slack Webhook URL (recommended) or a Bot Token and Channel ID
SLACK_WEBHOOK_URL="https://hooks.slack.com/services/YOUR/WEBHOOK/URL"
SLACK_TOKEN="xoxb-your-slack-bot-token"
SLACK_CHANNEL="C1234567890"

# ---------- DATABASE CONFIGURATION ----------
# SQLite (Local Dev fallback): sqlite:///jira_bot.db
# PostgreSQL (Docker default): postgresql+psycopg2://postgres:1803@postgres:5432/jira_slack_bot
DATABASE_URL="sqlite:///jira_bot.db"

# ---------- SCHEDULER CONFIGURATION ----------
# Time interval in seconds between checking for new/updated issues (e.g. 600 = 10 minutes)
CHECK_INTERVAL=600

# ---------- LOGGING CONFIGURATION ----------
LOG_LEVEL=INFO
