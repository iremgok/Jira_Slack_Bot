# Copy to .env and fill in real values. Never commit .env.

# ---------- APP ----------
APP_NAME="Jira Slack Bot"
TIMEZONE=Europe/Istanbul

# ---------- JIRA ----------
JIRA_BASE_URL=https://your-domain.atlassian.net
JIRA_EMAIL=your-email@example.com
# Create at https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_API_TOKEN=your-jira-api-token
JIRA_PROJECT_KEY=KAN
# Optional extra JQL filter, e.g. only the active sprint:
# JIRA_EXTRA_JQL=sprint in openSprints()
JIRA_EXTRA_JQL=
JIRA_TIMEOUT_SECONDS=30
# true = use bundled sample data instead of calling Jira (local development)
JIRA_MOCK_MODE=false

# ---------- SLACK ----------
# Option 1: Incoming Webhook (simplest)
SLACK_WEBHOOK_URL=
# Option 2: Bot token (needs chat:write scope) + channel ID
SLACK_BOT_TOKEN=
SLACK_CHANNEL=
# true = print messages to the log instead of sending them
SLACK_DRY_RUN=false

# ---------- DATABASE ----------
# SQLite (local):     sqlite:///jira_bot.db
# PostgreSQL:         postgresql+psycopg2://user:password@host:5432/dbname
DATABASE_URL=sqlite:///jira_bot.db
# Apply Alembic migrations automatically on startup (set false to run "alembic upgrade head" yourself)
DB_AUTO_MIGRATE=true
# Seconds to wait for the database to accept connections on startup
DB_CONNECT_TIMEOUT_SECONDS=60

# ---------- SCHEDULER ----------
# How often to look for new/updated issues (seconds, min 30)
POLL_INTERVAL_SECONDS=300
# How far back the very first poll looks (minutes)
INITIAL_LOOKBACK_MINUTES=60
# Standard 5-field cron, evaluated in TIMEZONE (default: every day at 18:00)
DAILY_REPORT_CRON=0 18 * * *

# ---------- REPORT ----------
CRITICAL_PRIORITIES=Highest,High
TOP_ASSIGNEE_COUNT=5

# ---------- LOGGING ----------
LOG_LEVEL=INFO
LOG_DIR=logs

# ---------- DOCKER COMPOSE (PostgreSQL) ----------
POSTGRES_USER=jira_bot
POSTGRES_PASSWORD=change-me
POSTGRES_DB=jira_slack_bot
